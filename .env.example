# ==============================================================================
# VendorIQ — Environment Configuration Template
# Copy this file to .env and configure the values for your deployment environment.
# ==============================================================================

# Application Environment Mode ('development' | 'production')
# In 'production' mode:
# - JWT_SECRET must be explicitly provided and >= 32 characters (cannot be the default dev key).
# - Wildcard '*' CORS is strictly rejected; explicit origins must be specified in CORS_ORIGINS.
# - Auto-creation of SQLite tables is disabled in favor of Alembic migrations.
# - seeds.py protects existing tables from accidental deletion.
ENV_MODE=production

# Database Connection URL
# For PostgreSQL: postgresql://username:password@hostname:5432/vendoriq
# Note: URLs starting with 'postgres://' (Render/Supabase/Heroku default) are automatically normalized.
# For local development with SQLite: sqlite:///./vendoriq.db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vendoriq

# JWT Authentication Secret Key (REQUIRED in production, minimum 32 characters)
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
# Both JWT_SECRET and SECRET_KEY are supported as aliases.
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated list of allowed frontend origins)
# Wildcards are rejected in production mode.
CORS_ORIGINS=https://vendoriq-rho.vercel.app,http://localhost:4200

# Frontend URL (used to generate password reset links sent to users)
FRONTEND_URL=https://vendoriq-rho.vercel.app

# Avatar & File Upload Storage Directory
# In containerized/cloud deployments (Render, Railway, Fly.io, AWS), point this
# to a mounted persistent disk volume (e.g. /var/data/uploads) so uploaded avatar
# files persist across container restarts and redeployments.
UPLOAD_DIR=uploads
